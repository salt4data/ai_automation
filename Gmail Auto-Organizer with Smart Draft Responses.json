    {
      "parameters": {
        "promptType": "define",
        "text": "=Email Details:\nFrom: {{ $json.emailFrom }}\nSubject: {{ $json.emailSubject }}\nBody: {{ $json.emailBody }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an email classification assistant. Analyze the email and:\n\n1. Classify into ONE of these categories:\n- JOB_ALERTS: Job posting notifications from LinkedIn Jobs, Indeed, Glassdoor, ZipRecruiter, or other job boards\n- JOB_APPLICATIONS: Application confirmations OR responses from recruiters/companies (subject contains: 'application received', 'thank you for applying', 'we received your application', 'interview', 'next steps', 'update on your application', 'regarding your application')\n- BLACK_WALLET: ANY email mentioning 'Black Wallet' (including Otter.ai meeting recordings)\n- BDPA: ANY email mentioning 'BDPA' (including Otter.ai meeting recordings)\n- GOD_FAITH: Emails about church, Bible studies, devotionals, Christian content, prayer requests, ministry\n- BILLS_BANK_STATEMENTS: Bills, invoices, bank statements, spending statements, financial documents from banks or service providers\n- NEWSLETTERS: Emails with unsubscribe links\n- SOCIAL_MEDIA: Facebook, LinkedIn, Twitter, Instagram notifications\n- SHOPPING: Amazon, eBay, receipts, order confirmations\n- PROMOTIONS: Sales, deals, discounts\n- OTHER: If none of the above match\n\n2. Determine if email requires a reply (contains questions, requests for information, or call to action)\n\n3. If reply needed, generate a professional, contextual draft response that:\n- Is polite and professional\n- Addresses specific questions or requests\n- Is appropriate for the context"
        }
      },
